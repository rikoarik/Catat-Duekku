{
  "expo": {
    "name": "catat-duekku",
    "slug": "catat-duekku",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Logo-Catat.png",
    "scheme": "catatduekku",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/Logo-Catat.png",
      "bundleIdentifier": "com.catatduekku.app"
    },
    "android": {
      "package": "com.catatduekku.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAFCFB",
        "foregroundImage": "./assets/images/Logo-Catat.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Logo-Catat.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFCFB",
          "image": "./assets/images/Logo-Catat.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#0F3D3E",
          "defaultChannel": "keuangan"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5bd57d2-8561-47e0-af5e-e1b31d7ecf4f"
      }
    },
    "owner": "prast53"
  }
}
